{
  "name": "stream-token-substitute",
  "version": "2.0.0",
  "description": "Streaming, chunk-boundary-safe, zero-copy byte-level token and literal substitution for Web Streams runtimes",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Ivan Buiko <ivan@buiko.com>",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "aho-corasick",
    "bun",
    "cloudflare-workers",
    "deno",
    "edge",
    "literal-replace",
    "replace",
    "search-replace",
    "stream",
    "streaming-replace",
    "substitution",
    "template",
    "token-replace",
    "transformstream",
    "web-streams",
    "zero-copy"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gc": "NODE_OPTIONS=--expose-gc vitest run test/streaming.test.ts test/memory.test.ts",
    "bench": "node --expose-gc bench/bench.ts",
    "typecheck": "tsc --noEmit && tsc -p runtime --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:workers": "vitest run -c vitest.workers.config.ts",
    "test:bun": "bun test runtime/bun.test.ts",
    "test:deno": "deno test runtime/deno.test.ts",
    "test:fuzz": "vitest run test/differential.test.ts test/literals.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.6.3",
    "@types/replacestream": "^4.0.4",
    "replace-content-transformer": "^3.0.2",
    "replacestream": "^4.0.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helsus/stream-token-substitute.git"
  },
  "homepage": "https://github.com/helsus/stream-token-substitute#readme",
  "bugs": {
    "url": "https://github.com/helsus/stream-token-substitute/issues"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "undici": "^7.30.0"
  }
}
